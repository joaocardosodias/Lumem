ENV=development

# Desenvolvimento: acessível no host local. Na VPS 2, use 10.50.0.2.
ML_BIND_ADDRESS=127.0.0.1
ML_PORT=8000

# O serviço de ML acessa o Supabase com um usuário somente leitura.
ML_DATABASE_URL=postgresql://ml_reader:sua-senha@seu-pooler.supabase.com:6543/postgres?sslmode=require&default_query_exec_mode=simple_protocol

# MinIO exclusivo dos artefatos e dados de treinamento do modelo.
MINIO_ROOT_USER=g04-model-admin
MINIO_ROOT_PASSWORD=gere-uma-senha-administrativa-forte
MINIO_APP_USER=g04-model-app
MINIO_APP_PASSWORD=gere-uma-senha-de-aplicacao-forte

MODEL_REGISTRY_DRIVER=s3
MODEL_S3_ENDPOINT=http://model-minio:9000
MODEL_S3_REGION=us-east-1
MODEL_S3_BUCKET=artefacts
MODEL_S3_ACCESS_KEY_ID=g04-model-app
MODEL_S3_SECRET_ACCESS_KEY=gere-a-mesma-senha-de-aplicacao
MODEL_S3_PREFIX=models/random-forest
MODEL_MANIFEST_KEY=models/random-forest/active/manifest.json
MODEL_CACHE_DIR=/tmp/g04-model-cache

MODEL_TRAINING_BUCKET=training-data
MODEL_PANEL_S3_KEY=datasets/current/painel.parquet
MODEL_MAINTENANCE_S3_KEY=datasets/current/ZM01_limpa.xlsx
MODEL_TRAINING_CACHE_DIR=/tmp/g04-training-data
TRAINING_JOB_DIR=/var/lib/g04/training-jobs
TRAINING_WORKER_POLL_SECONDS=1
MODEL_TRAIN_TIMEOUT_SECONDS=3600

ML_TRAINING_CPUS=1.50
ML_TRAINING_MEMORY=2g
