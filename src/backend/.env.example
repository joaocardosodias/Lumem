PORT=8080
ENV=development

# Registro privado das imagens de produção.
ACR_REGISTRY=g04docker.azurecr.io

RUN_MIGRATIONS=true

DB_DRIVER=postgres
DB_HOST=aws-0-us-west-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.SEU_PROJECT_REF
DB_PASSWORD=sua-senha-aqui
DB_SSLMODE=require
DATABASE_URL=postgresql://postgres.SEU_PROJECT_REF:sua-senha-aqui@aws-0-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require&default_query_exec_mode=simple_protocol
DB_MAX_OPEN_CONNS=5
DB_MAX_IDLE_CONNS=2

DB_PATH=database.db
MIGRATIONS_PATH=migrations

JWT_SECRET=coloque-sua-chave-secreta-aqui
VPS_MODEL_URL=http://localhost:8000
# Em producao, o servico de ML exige uma URL PostgreSQL de usuario somente leitura.
ML_DATABASE_URL=postgresql://ml_reader:sua-senha@seu-pooler.supabase.com:6543/postgres?sslmode=require&default_query_exec_mode=simple_protocol

# MinIO local. Use valores diferentes para a conta administrativa e a conta da aplicacao.
MINIO_ROOT_USER=g04-minio-admin
MINIO_ROOT_PASSWORD=gere-uma-senha-administrativa-forte
MINIO_APP_USER=g04-app
MINIO_APP_PASSWORD=gere-uma-senha-de-aplicacao-forte

# Registry privado de modelos no MinIO local.
MODEL_REGISTRY_DRIVER=s3
MODEL_ARTIFACT_PATH=
MODEL_MANIFEST_PATH=
MODEL_S3_ENDPOINT=http://minio:9000
MODEL_S3_REGION=us-east-1
MODEL_S3_BUCKET=artefacts
MODEL_S3_ACCESS_KEY_ID=g04-app
MODEL_S3_SECRET_ACCESS_KEY=gere-a-mesma-senha-de-aplicacao
MODEL_S3_PREFIX=models/random-forest
MODEL_MANIFEST_KEY=models/random-forest/active/manifest.json
MODEL_CACHE_DIR=/tmp/g04-model-cache

# Snapshots usados por um retreinamento real. Podem ser caminhos montados no
# container ou chaves privadas no mesmo storage S3.
MODEL_PANEL_PATH=
MODEL_MAINTENANCE_PATH=
MODEL_TRAINING_BUCKET=training-data
MODEL_PANEL_S3_KEY=datasets/current/painel.parquet
MODEL_MAINTENANCE_S3_KEY=datasets/current/ZM01_limpa.xlsx
MODEL_TRAINING_CACHE_DIR=/tmp/g04-training-data
TRAINING_JOB_DIR=/var/lib/g04/training-jobs
MODEL_TRAIN_TIMEOUT_SECONDS=3600
LOAD_TEST=false
LOAD_TEST_CPUS=0
LOAD_TEST_MEMORY=0

# Armazenamento privado dos arquivos de ingestao no MinIO local.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=ingestion-uploads
S3_ACCESS_KEY_ID=g04-app
S3_SECRET_ACCESS_KEY=gere-a-mesma-senha-de-aplicacao
S3_PREFIX=ingestion

# Fila duravel de ingestao (River usa o mesmo PostgreSQL da aplicacao).
RIVER_POLL_ONLY=true
RIVER_MAX_WORKERS=2
RIVER_MAX_ATTEMPTS=5

# Tracing distribuido via OpenTelemetry Collector e Grafana Tempo.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=g04-api
OTEL_WORKER_SERVICE_NAME=g04-worker
