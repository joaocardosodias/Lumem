PORT=8080
ENV=development

# Registro privado das imagens de produção.
ACR_REGISTRY=g04docker.azurecr.io

RUN_MIGRATIONS=true

DB_DRIVER=postgres
DB_HOST=aws-0-us-west-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.yqkcxaqorhekxbctewwj
DB_PASSWORD=sua-senha-aqui
DB_SSLMODE=require
DATABASE_URL=postgresql://postgres.yqkcxaqorhekxbctewwj:sua-senha-aqui@aws-0-us-west-2.pooler.supabase.com:6543/postgres?sslmode=require&default_query_exec_mode=simple_protocol
DB_MAX_OPEN_CONNS=5
DB_MAX_IDLE_CONNS=2

DB_PATH=database.db
MIGRATIONS_PATH=migrations

JWT_SECRET=coloque-sua-chave-secreta-aqui
VPS_MODEL_URL=http://localhost:8000
# Em producao, o servico de ML exige uma URL PostgreSQL de usuario somente leitura.
ML_DATABASE_URL=postgresql://ml_reader:sua-senha@seu-host:5432/postgres?sslmode=require

# Registry do modelo: local no desenvolvimento; s3 em staging/producao.
MODEL_REGISTRY_DRIVER=local
MODEL_ARTIFACT_PATH=
MODEL_MANIFEST_PATH=
MODEL_S3_ENDPOINT=
MODEL_S3_REGION=us-west-2
MODEL_S3_BUCKET=
MODEL_S3_ACCESS_KEY_ID=
MODEL_S3_SECRET_ACCESS_KEY=
MODEL_S3_PREFIX=models/random-forest
MODEL_MANIFEST_KEY=models/random-forest/active/manifest.json
MODEL_CACHE_DIR=/tmp/g04-model-cache

# Snapshots usados por um retreinamento real. Podem ser caminhos montados no
# container ou chaves privadas no mesmo storage S3.
MODEL_PANEL_PATH=
MODEL_MAINTENANCE_PATH=
MODEL_TRAINING_BUCKET=
MODEL_PANEL_S3_KEY=
MODEL_MAINTENANCE_S3_KEY=
MODEL_TRAINING_CACHE_DIR=/tmp/g04-training-data
TRAINING_JOB_DIR=/var/lib/g04/training-jobs
MODEL_TRAIN_TIMEOUT_SECONDS=3600
LOAD_TEST=false
LOAD_TEST_CPUS=0
LOAD_TEST_MEMORY=0

# Armazenamento dos arquivos de ingestao: local ou s3.
STORAGE_DRIVER=local
S3_ENDPOINT=https://SEU_PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=REGIAO_DO_PROJETO
S3_BUCKET=ingestion-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=ingestion

# Fila duravel de ingestao (River usa o mesmo PostgreSQL da aplicacao).
RIVER_POLL_ONLY=true
RIVER_MAX_WORKERS=2
RIVER_MAX_ATTEMPTS=5

# Tracing distribuido via OpenTelemetry Collector e Grafana Tempo.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=g04-api
OTEL_WORKER_SERVICE_NAME=g04-worker
